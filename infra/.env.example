# 复制为 .env 后按需修改：cp infra/.env.example infra/.env
# docker compose 会自动读取同目录下的 .env

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=geek_mall
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Grafana（observability profile） ----------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
