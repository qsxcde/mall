# 复制为 .env 后按需修改：cp infra/.env.example infra/.env
# docker compose 会自动读取同目录下的 .env

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=geek_mall
# 若本机已装 MySQL 并占用 3306，请改用其他宿主端口（如 3307），
# 并同步设置后端的 MYSQL_PORT（见 backend/src/main/resources/application-dev.yml）
MYSQL_PORT=3307

# ---------- Redis ----------
REDIS_PORT=6379
# 多实例 overlay（docker-compose.multi.yml）会用它给 Redis 设置 requirepass；
# 生产/多实例验证必须填写非空值。本地单实例 dev 可留空。
REDIS_PASSWORD=

# ---------- 后端安全 ----------
# JWT 签名密钥（至少 32 字节）。默认值是源码中公开的占位值，
# prod 环境下 ProdConfigGuard 会拒绝启动；部署前必须替换为随机值。
MALL_JWT_SECRET=geek-mall-jwt-secret-key-please-change-in-production-2026

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Grafana（observability profile） ----------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ---------- 支付宝沙箱（可选） ----------
# 本地联调支付宝时填写；密钥留空则后端自动走「本地沙箱渠道」（零配置可启动）。
# 详细步骤见 docs/benchmark/支付宝沙箱联调-*.md
#
# channel 取值：local（默认） / alipay
MALL_PAYMENT_CHANNEL=local
#
# 沙箱应用 appId
MALL_ALIPAY_APP_ID=
#
# 应用私钥：PKCS#8 或 PKCS#1 均可，支持带 PEM 头尾；也可写成单行 Base64（解析时会去掉空白）
MALL_ALIPAY_PRIVATE_KEY=
#
# 支付宝公钥（验签用）—— 注意不是「应用公钥」，两者不同
MALL_ALIPAY_PUBLIC_KEY=
#
# 收款方 PID（可选）：填了就额外校验通知里的 seller_id
MALL_ALIPAY_SELLER_ID=
#
# 异步通知地址：必须公网可达。本地联调用隧道把 localhost:8080 暴露出去，例如
# MALL_ALIPAY_NOTIFY_URL=https://xxxx.ngrok-free.app/api/v1/pay/callback
MALL_ALIPAY_NOTIFY_URL=
