# 复制为 .env 后按需修改：cp infra/.env.example infra/.env
# docker compose 会自动读取同目录下的 .env

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=geek_mall
# 若本机已装 MySQL 并占用 3306，请改用其他宿主端口（如 3307），
# 并同步设置后端的 MYSQL_PORT（见 backend/src/main/resources/application-dev.yml）
MYSQL_PORT=3307

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Grafana（observability profile） ----------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
